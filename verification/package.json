{
  "name": "typings-suitescript-verification",
  "private": true,
  "description": "Runs small probe scripts in a NetSuite sandbox to check what the platform really does. Not part of the published typings.",
  "type": "module",
  "scripts": {
    "verify:certificate": "suitescript-verify certificate --dir .",
    "verify:cleanup": "suitescript-verify cleanup --dir .",
    "verify:deploy": "suitescript-verify deploy --dir .",
    "verify:doctor": "suitescript-verify doctor --dir .",
    "verify:env": "suitescript-verify env --dir .",
    "verify:passkey": "suitescript-verify passkey --dir .",
    "verify:run": "suitescript-verify run --dir .",
    "verify:setup-ci": "suitescript-verify setup-ci --dir ."
  },
  "devDependencies": {
    "@oracle/suitecloud-cli": "4.1.1",
    "suitescript-verify": "1.1.0"
  },
  "allowScripts": {
    "@oracle/suitecloud-cli": true
  }
}
