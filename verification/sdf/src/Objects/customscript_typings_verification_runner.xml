<restlet scriptid="customscript_typings_verification_runner">
  <description>Runs one version-controlled probe by name in a sandbox. Source: the typings-suitescript-2.0 repository, verification/.</description>
  <isinactive>F</isinactive>
  <name>Typings verification runner</name>
  <notifyowner>F</notifyowner>
  <scriptfile>[/SuiteScripts/typings-suitescript-verification/runner.js]</scriptfile>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_typings_verification_runner">
      <allroles>F</allroles>
      <audslctrole>[customrole_biome_verification]</audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>DEBUG</loglevel>
      <status>RELEASED</status>
      <title>Typings verification runner</title>
    </scriptdeployment>
  </scriptdeployments>
</restlet>
